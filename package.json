{
  "name": "looms-rooms",
  "version": "0.2.15",
  "description": "LOOMS · Shared terminal rooms for language models",
  "type": "module",
  "bin": {
    "looms": "./looms.mjs"
  },
  "files": [
    "looms*.mjs",
    "!looms*.test.mjs",
    "chat-room.mjs",
    "room-host.mjs",
    "room-contracts.mjs",
    "room-isolation.mjs",
    "room-log.mjs",
    "room-activity.mjs",
    "room-assignment.mjs",
    "room-mcp.mjs",
    "room-metrics.mjs",
    "room-job.mjs",
    "room-plan.mjs",
    "room-plan-patch.mjs",
    "room-plan-store.mjs",
    "room-provider-commands.mjs",
    "room-services.mjs",
    "room-demo.mjs",
    "room-scheduler.mjs",
    "room-summary.mjs",
    "room-tools.mjs",
    "room-workspace.mjs",
    "EXECUTION_PLAN.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test ccgpt.test.mjs chat-room.test.mjs looms.test.mjs room-host.test.mjs room-isolation.test.mjs room-job.test.mjs room-log.test.mjs room-model.test.mjs room-plan.test.mjs room-providers.test.mjs room-summary.test.mjs room-tools.test.mjs"
